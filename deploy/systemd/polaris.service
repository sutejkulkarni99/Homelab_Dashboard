[Unit]
Description=Polaris Hub (FastAPI)
After=network.target

[Service]
Type=simple
WorkingDirectory=%INSTALL_DIR%/master
EnvironmentFile=%INSTALL_DIR%/master/.env
Environment=POLARIS_PORT=3030
Environment=POLARIS_PROJECTS_DIR=%h/Projects
ExecStart=%INSTALL_DIR%/master/.venv-staging/bin/python %INSTALL_DIR%/master/app_new.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
